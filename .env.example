# folia-termux 配置模板：复制成 .env.local 再改。
# .env.local 已被 .gitignore 忽略，密钥不要提交。

# ---- 前端（Vite 在 build/dev 时读取，必须 VITE_ 前缀）----

# 网易云 API 走同源反代：server/index.mjs 会把 /netease/* 转到 127.0.0.1:3300。
# 单一 origin 可避免手机端的跨域与 host 问题。
VITE_NETEASE_API_BASE=/netease

# 可选音源（留空 = 入口可见但不可用；各自需要单独部署实例）
VITE_KUGOU_API_BASE=
VITE_QQ_API_BASE=

# AI 主题生成：google（Gemini）或 openai（OpenAI 兼容）
VITE_AI_PROVIDER=google

# ---- 服务端 AI（server/index.mjs 与 /api 处理器读取）----

# 歌词分词按这个键选 provider（不是 VITE_AI_PROVIDER）：openai 或留空。
AI_PROVIDER=google

GEMINI_API_KEY=

OPENAI_API_KEY=
OPENAI_API_URL=https://api.deepseek.com
OPENAI_API_MODEL=deepseek-flash
OPENAI_API_TEMPERATURE=0.7

# ---- server/index.mjs 运行时（可选，一般不用改）----
# PORT=3000
# NETEASE_PORT=3300
# NETEASE_AUTOSTART=true
